# ============================================
# 环境变量模板 — 复制为 .env 并填入真实值
# 生产服务器上对应路径: /opt/app/.env
# ============================================

# --- 数据库 ---
DB_URL=jdbc:mysql://your-host:3306/test_data?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=Asia/Shanghai
DB_USERNAME=your_db_user
DB_PASSWORD=your_db_password

# --- Redis ---
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# --- RabbitMQ ---
RABBITMQ_HOST=127.0.0.1
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=guest

# --- Nacos（生产配置中心，chat-common-prod.yml 等） ---
NACOS_ENABLED=true
NACOS_HOST=127.0.0.1
NACOS_PORT=8848
NACOS_USERNAME=nacos
NACOS_PASSWORD=nacos

# --- Milvus 向量库 ---
MILVUS_ENABLED=true
MILVUS_HOST=127.0.0.1
MILVUS_PORT=19530

# --- Neo4j 知识图谱（可选：2026-09-29 起生产图谱默认 Milvus 后端） ---
NEO4J_URI=bolt://127.0.0.1:7687
NEO4J_PASSWORD=your_neo4j_password

# --- JWT ---
JWT_SECRET=change-me-to-a-random-256-bit-string

# --- 阿里云 OSS ---
OSS_ACCESS_KEY_ID=your_oss_ak
OSS_ACCESS_KEY_SECRET=your_oss_sk

# --- 内容安全 (阿里云) ---
ALIBABA_CLOUD_ACCESS_KEY_ID=your_cs_ak
ALIBABA_CLOUD_ACCESS_KEY_SECRET=your_cs_sk

# --- LLM Provider Keys ---
# 【重要】生产环境(prod)下，LLM 提供商 key 的唯一真相源是数据库 llm_provider_props 表，
#         chat-llm / chat-core 均从 DB 加载并每 60 秒定时刷新覆盖（改 key 无需重启）。
#         此处 *_API_KEY 仅作为 standalone 模式(无 DB)或 DB 故障时的 YAML 兜底，
#         请务必与 DB 保持一致。
# 【加密】DB 中的 api_key 为 AES-256-GCM 密文（enc:v1: 前缀，见 ApiKeyCipher）。
#         APP_MASTER_KEY 为加密主密钥：丢失/变更 = DB 中全部 api_key 无法解密（需重录），
#         未配置时管理面保存的 key 将明文落库（仅本地开发可接受）。
DEEPSEEK_API_KEY=your_deepseek_key
QWEN_API_KEY=your_qwen_key
DOUBAO_API_KEY=your_doubao_key
LLM_API_KEY=your_qwen_key
APP_MASTER_KEY=change-me-openssl-rand-hex-32

# --- DashScope (百炼) ---
# DASHSCOPE_API_KEY 另用于 RAG/意图向量化(embedding)，该路径不走 DB，属例外，需单独保持有效
DASHSCOPE_API_KEY=your_dashscope_key

# --- 内部密码 ---
SQL_EXECUTOR_PASSWORD=your_sql_exec_password
MONITOR_PASSWORD=your_monitor_password

# --- 内部接口令牌（/internal/** 校验 X-Internal-Token，chat-web 与 chat-core 同值） ---
INTERNAL_API_TOKEN=change-me-openssl-rand-hex-32

# --- 钉钉告警 webhook（可选，空则告警仅落盘） ---
DINGTALK_WEBHOOK=

# --- RAG / 知识图谱 / 意图识别 ---
RAG_ENABLED=true
KNOWLEDGE_GRAPH_ENABLED=true
INTENT_ENABLED=true
INTENT_MODEL=qwen-turbo
EMBEDDING_MODE=dashscope
EMBEDDING_DIMENSION=1024
EMBEDDING_MODEL=text-embedding-v4
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/api/v1
# chat-llm 服务地址（RagClient 与知识库代理指向）
LLM_SERVICE_BASE_URL=http://127.0.0.1:9095
