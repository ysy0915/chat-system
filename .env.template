# ============================================
# 环境变量模板 — 复制为 .env 并填入真实值
# 生产服务器上对应路径: /opt/app/.env
# ============================================

# --- 数据库 ---
DB_URL=jdbc:mysql://your-host:3306/test_data?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=Asia/Shanghai
DB_USERNAME=your_db_user
DB_PASSWORD=your_db_password

# --- Redis ---
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# --- RabbitMQ ---
RABBITMQ_HOST=127.0.0.1
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=guest

# --- JWT ---
JWT_SECRET=change-me-to-a-random-256-bit-string

# --- 阿里云 OSS ---
OSS_ACCESS_KEY_ID=your_oss_ak
OSS_ACCESS_KEY_SECRET=your_oss_sk

# --- 内容安全 (阿里云) ---
ALIBABA_CLOUD_ACCESS_KEY_ID=your_cs_ak
ALIBABA_CLOUD_ACCESS_KEY_SECRET=your_cs_sk

# --- DashScope (百炼) ---
DASHSCOPE_API_KEY=your_dashscope_key

# --- Neo4j ---
NEO4J_PASSWORD=your_neo4j_password

# --- 内部密码 ---
SQL_EXECUTOR_PASSWORD=your_sql_exec_password
MONITOR_PASSWORD=your_monitor_password
