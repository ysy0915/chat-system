# ============================================
# 环境变量模板 — 复制为 .env 并填入真实值
# 生产服务器上对应路径: /opt/app/.env
# ============================================

# --- 数据库 ---
DB_URL=jdbc:mysql://your-host:3306/test_data?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=Asia/Shanghai
DB_USERNAME=your_db_user
DB_PASSWORD=your_db_password

# --- Redis ---
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# --- RabbitMQ ---
RABBITMQ_HOST=127.0.0.1
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=guest

# --- JWT ---
JWT_SECRET=change-me-to-a-random-256-bit-string

# --- 阿里云 OSS ---
OSS_ACCESS_KEY_ID=your_oss_ak
OSS_ACCESS_KEY_SECRET=your_oss_sk

# --- 内容安全 (阿里云) ---
ALIBABA_CLOUD_ACCESS_KEY_ID=your_cs_ak
ALIBABA_CLOUD_ACCESS_KEY_SECRET=your_cs_sk

# --- LLM Provider Keys ---
# 【重要】生产环境(prod)下，LLM 提供商 key 的唯一真相源是数据库 llm_provider_props 表，
#         chat-llm / chat-core 均从 DB 加载并每 60 秒定时刷新覆盖（改 key 无需重启）。
#         此处 *_API_KEY 仅作为 standalone 模式(无 DB)或 DB 故障时的 YAML 兜底，
#         请务必与 DB 保持一致。
DEEPSEEK_API_KEY=your_deepseek_key
QWEN_API_KEY=your_qwen_key
DOUBAO_API_KEY=your_doubao_key
LLM_API_KEY=your_qwen_key

# --- DashScope (百炼) ---
# DASHSCOPE_API_KEY 另用于 RAG/意图向量化(embedding)，该路径不走 DB，属例外，需单独保持有效
DASHSCOPE_API_KEY=your_dashscope_key

# --- Neo4j ---
NEO4J_PASSWORD=your_neo4j_password

# --- 内部密码 ---
SQL_EXECUTOR_PASSWORD=your_sql_exec_password
MONITOR_PASSWORD=your_monitor_password
