# chat-core Dockerfile - 核心 AI 服务
FROM maven:3-eclipse-temurin-17 AS builder
WORKDIR /build
COPY pom.xml .
COPY chat-common/pom.xml chat-common/
COPY chat-core/pom.xml chat-core/
RUN mvn dependency:go-offline -pl chat-core -am -DskipTests || true
COPY chat-common/src chat-common/src/
COPY chat-core/src chat-core/src/
RUN mvn package -pl chat-core -am -DskipTests -q

FROM eclipse-temurin:17-jre-alpine
WORKDIR /app
COPY --from=builder /build/chat-core/target/chat-core-*.jar app.jar
RUN addgroup -S app && adduser -S app -G app && chown -R app:app /app
USER app
EXPOSE 9090
ENTRYPOINT ["java", "-jar", "app.jar"]
