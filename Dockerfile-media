# chat-media Dockerfile - 多模态服务
FROM maven:3-eclipse-temurin-17 AS builder
WORKDIR /build
COPY pom.xml .
COPY chat-common/pom.xml chat-common/
COPY chat-media/pom.xml chat-media/
RUN mvn dependency:go-offline -pl chat-media -am -DskipTests || true
COPY chat-common/src chat-common/src/
COPY chat-media/src chat-media/src/
RUN mvn package -pl chat-media -am -DskipTests -q

FROM eclipse-temurin:17-jre-alpine
WORKDIR /app
COPY --from=builder /build/chat-media/target/chat-media-*.jar app.jar
RUN addgroup -S app && adduser -S app -G app && chown -R app:app /app
USER app
EXPOSE 8084
ENTRYPOINT ["java", "-jar", "app.jar"]
