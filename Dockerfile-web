# chat-web Dockerfile - Web 接入层
FROM maven:3-eclipse-temurin-17 AS builder
WORKDIR /build
COPY pom.xml .
COPY chat-common/pom.xml chat-common/
COPY chat-web/pom.xml chat-web/
RUN mvn dependency:go-offline -pl chat-web -am -DskipTests || true
COPY chat-common/src chat-common/src/
COPY chat-web/src chat-web/src/
RUN mvn package -pl chat-web -am -DskipTests -q

FROM eclipse-temurin:17-jre-alpine
WORKDIR /app
COPY --from=builder /build/chat-web/target/chat-web-*.jar app.jar
RUN addgroup -S app && adduser -S app -G app && chown -R app:app /app
USER app
EXPOSE 8080
ENTRYPOINT ["java", "-jar", "app.jar"]
