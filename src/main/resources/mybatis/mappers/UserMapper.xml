<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
  PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
  "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.example.chat.repository.UserRepository">
  <resultMap id="UserResult" type="com.example.chat.entity.User">
    <id property="id" column="id"/>
    <result property="email" column="email"/>
    <result property="passwordHash" column="password_hash"/>
    <result property="name" column="name"/>
    <result property="role" column="role"/>
    <result property="createdAt" column="created_at"/>
  </resultMap>

  <select id="findByEmail" resultMap="UserResult" parameterType="string">
    SELECT id, email, password_hash, name, role, created_at FROM users WHERE email = #{email}
  </select>

  <select id="findByName" resultMap="UserResult" parameterType="string">
    SELECT id, email, password_hash, name, role, created_at FROM users WHERE name = #{name}
  </select>

  <insert id="insert" parameterType="com.example.chat.entity.User" useGeneratedKeys="true" keyProperty="id">
    INSERT INTO users (email, password_hash, name, role, created_at)
    VALUES (#{email}, #{passwordHash}, #{name}, #{role}, NOW())
  </insert>
</mapper>
